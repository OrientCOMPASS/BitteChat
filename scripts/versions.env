# Pinned dependency versions for the Android native build chain.
# Bump deliberately; CI caches are keyed on this file's hash.
BOOST_VERSION=1.90.0
OPENSSL_VERSION=3.5.5
LIBTORRENT_VERSION=2.1.2
ANDROID_API=24
# space separated; armeabi-v7a can be added later
ABIS="arm64-v8a x86_64"
RUST_PROFILE=release
